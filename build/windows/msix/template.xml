<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="plexflip"
        Arguments=""
        InstallLocation="C:\Program Files\Code Rage\PlexFlip">
    </Installer>
    <PackageInformation
        PackageName="PlexFlip"
        PackageDisplayName="PlexFlip"
        PublisherName="CN=Code Rage"
        PublisherDisplayName="Code Rage"
        Version="0.1.0.0"
        PackageDescription="PlexFlip Plex Client">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.coderage.plexflip"
                Description="PlexFlip Plex Client"
                DisplayName="PlexFlip"
                ExecutableName="plexflip"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>PlexFlip</DisplayName>
            <PublisherDisplayName>Code Rage</PublisherDisplayName>
            <Description>PlexFlip Plex Client</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="plexflip.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
