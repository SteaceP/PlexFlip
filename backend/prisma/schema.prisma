// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/plexflip.db"
}

model UserOption {
  userUid String
  key String
  value String

  @@id([userUid, key])
  @@unique([userUid, key])
}

model PlexFlipReviewsLocal {
  itemID String
  userID String
  created_at DateTime @default(now())

  rating Int
  message String @default("No review text provided")
  spoilers Boolean @default(false)

  user PlexFlipReviewsLocalUsers @relation(fields: [userID], references: [id])

  @@id([itemID, userID])
  @@unique([itemID, userID])
}

model PlexFlipReviewsLocalUsers {
  id String @default(cuid())
  created_at DateTime @default(now())

  username String
  avatar String

  @@id([id])
  @@unique([id])

  reviews PlexFlipReviewsLocal[]
}