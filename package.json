{
  "name": "plexflip",
  "version": "0.1.0",
  "private": true,
  "description": "PlexFlip - Plex Web UI with Go backend and embedded React frontend",
  "scripts": {
    "build": "make build",
    "build:frontend": "make build-frontend",
    "build:backend": "make build-backend",
    "build:desktop": "make build-desktop",
    "build:server": "make build-server",
    "wails:dev": "wails3 dev",
    "wails:build": "wails3 build",
    "wails:package": "wails3 package",
    "start:frontend": "pnpm --dir frontend start",
    "start:backend": "cd backend && go run .",
    "lint": "pnpm --dir frontend lint",
    "lint:fix": "pnpm --dir frontend lint:fix",
    "format": "pnpm --dir frontend format",
    "fix": "pnpm --dir frontend fix",
    "test": "make test",
    "clean": "make clean"
  }
}
